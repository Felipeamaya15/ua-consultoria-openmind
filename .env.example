# ==============================================================================
# CONFIGURACIÓN GENERAL DE DJANGO
# ==============================================================================
# Clave secreta única generada para el entorno (no reutilizar la de desarrollo)
DJANGO_SECRET_KEY=REEMPLAZAR_CON_CLAVE_ALEATORIA_UNICA
DJANGO_DEBUG=1

# Cifrado de credenciales de pago en BD (Fernet Key de 32 bytes en base64)
# Generar en servidor con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYMENT_CREDENTIALS_KEY=REEMPLAZAR_CON_CLAVE_FERNET_GENERADA

# Redirección y orígenes seguros (completar con el dominio final del proyecto)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=https://tudominio.cl
DJANGO_CSRF_TRUSTED_ORIGINS=https://tudominio.cl
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000

# ==============================================================================
# BASES DE DATOS (POSTGRESQL & MONGODB)
# ==============================================================================
POSTGRES_DB=ecommerce_db
POSTGRES_USER=ecommerce_admin
POSTGRES_PASSWORD=REEMPLAZAR_CON_PASSWORD_POSTGRES
POSTGRES_PORT=5432

MONGO_USER=admin_mongo
MONGO_PASSWORD=REEMPLAZAR_CON_PASSWORD_MONGO
MONGO_DB_NAME=consultoria_nosql

# ==============================================================================
# APIS, AUTENTICACIÓN Y ENLACES PÚBLICOS
# ==============================================================================
VITE_API_URL=https://api.tudominio.cl
GOOGLE_CLIENT_ID=76664192595-etnqg80mscvv62p1c42a0f2gndcqpmrh.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=76664192595-etnqg80mscvv62p1c42a0f2gndcqpmrh.apps.googleusercontent.com

PICKUP_GEOCODING_PROVIDER=
PICKUP_GOOGLE_GEOCODING_KEY=

# Dirección pública base para armar los enlaces de seguimiento en los correos
STOREFRONT_PUBLIC_URL=https://tudominio.cl/plantilla/1

# ==============================================================================
# CORREO TRANSACCIONAL (SMTP / BREVO / RESEND / AWS SES)
# ==============================================================================
# Motor SMTP estándar de Django
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Host y puerto del relay SMTP (Brevo: smtp-relay.brevo.com, puerto 587)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587

# Protocolo de seguridad: 1 para TLS (puerto 587), 0 para SSL (puerto 465)
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0

# Login técnico proporcionado por el proveedor (en Brevo tiene el formato cXXXXXXX@smtp-brevo.com)
EMAIL_HOST_USER=REEMPLAZAR_CON_LOGIN_SMTP

# Clave SMTP o token de relay generado en el panel del proveedor
EMAIL_HOST_PASSWORD=REEMPLAZAR_CON_CLAVE_SMTP

# Remitente formal visible. El correo debe estar verificado en el panel SMTP.
# Formato: Nombre Comercial <contacto@tudominio.cl>
DEFAULT_FROM_EMAIL=E-Commerce <contacto@tudominio.cl>

# URL publica HTTPS del backend para el callback de TUU Pago Online.
TUU_CALLBACK_BASE_URL=
# PayPal no admite CLP: se cobra en USD con el dolar observado, que se obtiene y refresca solo.

# Margen (%) sobre el observado para cubrir variacion del dolar y comision de conversion de PayPal.
PAYPAL_FX_MARGEN_PCT=2
# Horas maximas de antiguedad del dato
PAYPAL_FX_MAX_EDAD_HORAS=96
PAYPAL_FX_REFRESCO_HORAS=6
BCCH_USUARIO=
BCCH_CLAVE=

# ==============================================================================
# BLUE EXPRESS
# ==============================================================================
BLUE_EXPRESS_ENABLED=0
BLUE_EXPRESS_ENVIRONMENT=qa

# Credenciales del backend. Nunca utilizar variables VITE_ para estos secretos.
BLUE_EXPRESS_TOKEN=
BLUE_EXPRESS_USERCODE=
BLUE_EXPRESS_CLIENT_ACCOUNT=
BLUE_EXPRESS_USERNAME=

# Se completarán al verificar los endpoints de cada servicio.
BLUE_EXPRESS_GEO_URL=https://bx-tracking.bluex.cl/bx-geo/state/all
BLUE_EXPRESS_PRICING_URL=
BLUE_EXPRESS_EMISSION_URL=
BLUE_EXPRESS_LABEL_URL=
BLUE_EXPRESS_TRACKING_URL=

BLUE_EXPRESS_CONNECT_TIMEOUT=5
BLUE_EXPRESS_READ_TIMEOUT=20
