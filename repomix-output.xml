                          setAddress(
                            (current) => ({
                              ...current,
                              region:
                                event.target
                                  .value,
                            }),
                          )
                        }
                        options={REGIONES}
                      />
                    </div>
                  </div>
                )}
            </div>
          )}

          {/* ===============================================
