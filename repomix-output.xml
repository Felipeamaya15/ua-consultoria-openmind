                        cuenta Mercado Pago
                      </p>
                    </div>
                  </div>

                  <CardFields
                    prefix="mp"
                    data={mercadopago}
                    onField={setMpField}
                    errors={errors}
                  />

                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <Select
                      label="Cuotas"
                      value={
                        mercadopago.installments
                      }
                      onChange={(event) =>
                        setMercadopago(
                          (current) => ({
                            ...current,
                            installments:
