              {/* TRANSFERENCIA */}
              {paymentMethod ===
                'Transferencia' && (
                <div
                  className={
                    isMinimal
                      ? 'bg-[var(--info-bg)] border border-[var(--info)] rounded-[18px] p-5 text-sm space-y-2'
                      : 'bg-[var(--info-bg)] border border-[var(--info)] rounded-xl p-4 text-sm space-y-2'
                  }
                >
