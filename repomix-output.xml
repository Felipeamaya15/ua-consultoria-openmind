                  ? 'text-2xl md:text-3xl font-semibold tracking-tight'
                  : 'text-xl font-semibold'
              }
            >
              Productos relacionados
            </h2>

            {isMinimal && (
              <Link
                to={route('catalogo')}
                className="text-sm text-[#17213b] hover:opacity-60 transition-opacity"
