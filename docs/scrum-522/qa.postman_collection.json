{
  "info": {
    "name": "SCRUM-522 - QA local aislada",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "QA exclusiva en puerto 8001. Lecturas y rechazos de entradas inseguras; no inicia OAuth valido ni envia correos. Tokens solo desde el entorno privado local."
  },
  "variable": [
    {
      "key": "qaBaseUrl",
      "value": "http://localhost:8001"
    },
    {
      "key": "ownerToken",
      "value": ""
    },
    {
      "key": "verifiedBuyerToken",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const base = pm.variables.get(\"qaBaseUrl\");",
          "if (!/^http:\\/\\/(localhost|127\\.0\\.0\\.1):8001$/.test(base)) throw new Error(\"Solo se admite el servidor QA local en el puerto 8001.\");"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Estado de correo aislado",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{ownerToken}}"
          }
        ],
        "url": "{{qaBaseUrl}}/api/tienda/correo/google/estado/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Contrato exito\", () => pm.expect(pm.response.json().exito).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "Audiencia verificada",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{ownerToken}}"
          }
        ],
        "url": "{{qaBaseUrl}}/api/tienda/campanas/destinatarios/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Contrato exito\", () => pm.expect(pm.response.json().exito).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "Borradores persistentes",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{ownerToken}}"
          }
        ],
        "url": "{{qaBaseUrl}}/api/tienda/campanas/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Contrato exito\", () => pm.expect(pm.response.json().exito).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "Contactos existentes",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{ownerToken}}"
          }
        ],
        "url": "{{qaBaseUrl}}/api/tienda/contactos/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Contrato exito\", () => pm.expect(pm.response.json().exito).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "Plantillas transaccionales",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{ownerToken}}"
          }
        ],
        "url": "{{qaBaseUrl}}/api/tienda/correos/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Contrato exito\", () => pm.expect(pm.response.json().exito).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "Correo sin sesión",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://127.0.0.1:8001/api/tienda/correo/google/estado/",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Preferencia propia verificada",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{verifiedBuyerToken}}"
          }
        ],
        "url": "{{qaBaseUrl}}/api/consentimiento/mi-preferencia/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Correo propio verificado\", () => { const d=pm.response.json().data; pm.expect(d.correo_verificado).to.eql(true); pm.expect(d.email).to.eql(\"verified-buyer@example.test\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Rechaza preferencia de terceros",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{verifiedBuyerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{qaBaseUrl}}/api/consentimiento/mi-preferencia/",
        "body": {
          "mode": "raw",
          "raw": "{\"recibir\": true, \"email\": \"third@example.test\", \"version_texto\": \"correo-promocional-v1\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Propietario no concede preferencia de cliente",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{ownerToken}}"
          }
        ],
        "url": "{{qaBaseUrl}}/api/consentimiento/mi-preferencia/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "OAuth exige autorizacion expresa",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{ownerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{qaBaseUrl}}/api/tienda/correo/google/iniciar/",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Filtros de contactos concuerdan",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{ownerToken}}"
          }
        ],
        "url": "{{qaBaseUrl}}/api/tienda/contactos/?q=qa-filter-&consentimiento=pendiente&fecha_desde=2026-11-14&fecha_hasta=2026-11-14"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Doce contactos pendientes del dia\", () => { const r=pm.response.json(); pm.expect(r.paginacion.total).to.eql(12); pm.expect(r.data.length).to.eql(12); r.data.forEach(c=>{pm.expect(c.email).to.match(/^qa-filter-(0[0-9]|1[01])@example\\.test$/); pm.expect(c.consentimiento).to.eql(\"pendiente\");}); });"
            ]
          }
        }
      ]
    }
  ]
}
