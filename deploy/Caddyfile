# Caddy: recibe las visitas, pone el candado HTTPS (certificado automático) y reparte el trabajo.
# Las variables con valor por defecto permiten usar este mismo archivo dentro de Docker y en pruebas.

{$DOMAIN:localhost} {
	encode zstd gzip

	# Límite de tamaño de lo que se sube (imágenes de productos y de la tienda).
	request_body {
		max_size 25MB
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}

	# La API, el administrador de Django y las imágenes de la tienda las atiende el backend.
	@backend path /api/* /admin/* /media/* /landing/* /sitemap.xml
	handle @backend {
		reverse_proxy {$BACKEND_UPSTREAM:backend:8000}
	}

	# Estilos del administrador de Django (los deja "collectstatic" en un volumen).
	handle_path /static/* {
		root * {$STATIC_ROOT:/srv/static}
		file_server
	}

	# Todo lo demás es la página de la tienda; las direcciones internas vuelven al index.html.
	handle {
		root * {$WEB_ROOT:/srv/app}
		@archivos path /assets/*
		header @archivos Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
