# Variables de producción de OpenMind E-commerce.
# No edites este archivo: ejecuta "bash deploy/preparar_env.sh tutienda.cl" y creará deploy/.env
# con las claves ya generadas. Luego completa solo lo que dice "COMPLETAR" u "OBLIGATORIO".
# deploy/.env NUNCA se sube a Git ni se comparte.

# --- Dirección de la tienda (sin https:// ni barras). Para probar en tu computador: localhost
DOMAIN=tutienda.cl

# --- Claves (las genera preparar_env.sh; no las cambies después de usar la tienda)
DJANGO_SECRET_KEY=REEMPLAZAR
PAYMENT_CREDENTIALS_KEY=REEMPLAZAR

# --- Bases de datos
POSTGRES_DB=openmind
POSTGRES_USER=openmind
POSTGRES_PASSWORD=REEMPLAZAR
MONGO_USER=openmind
MONGO_PASSWORD=REEMPLAZAR
MONGO_DB_NAME=openmind

# --- HTTPS estricto del navegador. Déjalo en 0 al principio; cuando el candado funcione
#     en todas las páginas, cámbialo a 31536000 (un año) y reinicia.
DJANGO_SECURE_HSTS_SECONDS=0

# --- Inicio de sesión con Google (OBLIGATORIO: sin este valor la página de ingreso no abre)
# Es el "ID de cliente" que entrega Google Cloud (termina en .apps.googleusercontent.com).
# Solo para PROBAR en tu computador sirve cualquier valor, por ejemplo: prueba-local.apps.googleusercontent.com
# (el botón de Google no funcionará, pero el ingreso con correo y contraseña sí).
GOOGLE_CLIENT_ID=

# --- Correo de la tienda (Brevo u otro servicio SMTP) (COMPLETAR)
# Puerto 587 con TLS=1 y SSL=0. Si tu proveedor bloquea el 587, usa 2525 con los mismos valores.
# Si usas el puerto 465, pon EMAIL_USE_TLS=0 y EMAIL_USE_SSL=1.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Nombre y dirección que verán tus clientes. La dirección debe estar verificada en tu servicio de correo.
DEFAULT_FROM_EMAIL=Mi Tienda <contacto@tutienda.cl>

# --- Retiro en tienda con búsqueda de direcciones (opcional)
PICKUP_GEOCODING_PROVIDER=
PICKUP_GOOGLE_GEOCODING_KEY=

# --- Cobros con PayPal en dólares (opcional)
# El sistema convierte pesos a dólares con el tipo de cambio del día: usa primero el Banco Central, si completas
# BCCH_TOKEN (se solicita en el sitio del Banco Central), y si no, el sitio mindicador.cl.
# Sin ese dato igual funciona. Los demás valores (margen de 2 %, refresco cada 6 horas, antigüedad máxima
# de 96 horas) ya vienen definidos: agrégalos aquí solo si quieres cambiarlos (PAYPAL_FX_MARGEN_PCT,
# PAYPAL_FX_REFRESCO_HORAS, PAYPAL_FX_MAX_EDAD_HORAS).
BCCH_TOKEN=

# --- Sesiones (opcional). El administrador se cierra a los 30 minutos de inactividad; el cliente dura 30 días.
# DJANGO_ADMIN_SESSION_COOKIE_AGE=1800
# DJANGO_CUSTOMER_SESSION_COOKIE_AGE=2592000
# ADMIN_SESSION_INACTIVITY_TIMEOUT_SECONDS=1800

# --- Gmail del emprendedor y envío de campañas (opcional)
# Para conectar una cuenta de Gmail: crea un cliente OAuth en Google Cloud y completa estos dos datos. La dirección de
# redirección autorizada en Google debe ser exactamente:  https://TU_DOMINIO/api/tienda/correo/google/callback/
# GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY la genera preparar_env.sh (cifra los tokens de Gmail). No la cambies después de
# conectar una cuenta, o habrá que volver a conectarla. Respáldala junto con PAYMENT_CREDENTIALS_KEY.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY=REEMPLAZAR
# Envío real de correos de campañas: déjalo en 0 hasta querer autorizarlo. Con 0 no se envía nada hacia afuera.
# STORE_MAIL_EXTERNAL_ENABLED=0
# STORE_MAIL_HOURLY_LIMIT=100
# STORE_MAIL_DAILY_LIMIT=500
